{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.venv/**,tests/**,test-results/**,public/videos/**,public/images/cobalt-inspection.png,dist/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/scanner", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" },
    { "source": "/journey", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/analytics", "destination": "/index.html" },
    { "source": "/technology", "destination": "/index.html" },
    { "source": "/business", "destination": "/index.html" }
  ]
}
